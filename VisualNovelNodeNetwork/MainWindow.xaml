<Window x:Class="VisualNovelNodeNetwork.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisualNovelNodeNetwork"
        xmlns:nodenetwork="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Grid.Column="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="mnuNew_Click"/>
                <MenuItem Header="_Open" Click="mnuOpen_Click"/>
                <MenuItem Header="_Save" Click="mnuSave_Click"/>
                <MenuItem Header="_Save As" Click="mnuSaveAs_Click"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="mnuExit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Network View -->
        <nodenetwork:NetworkView x:Name="networkView" Grid.Row="1" Grid.Column="0" 
                                 ViewModel="{Binding Network}"
                                 AllowDrop="True"
                                 DragEnter="NetworkView_DragEnter"
                                 Drop="NetworkView_Drop"
                                 DragOver="NetworkView_DragOver"
                                 DragLeave="NetworkView_DragLeave"/>

        <!-- Node List Panel -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Background="#F5F5F5">
            <DockPanel>
                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Available Nodes" FontWeight="Bold" Padding="10" FontSize="14" />
                <TextBlock DockPanel.Dock="Top" Text="Drag to canvas" FontSize="11" Foreground="#666666" Padding="10,0,10,10" />

                <!-- Node Type List -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="nodeListBox" ItemsSource="{Binding NodeList.NodeTypes}" Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="White" Margin="8,4" 
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                        MouseLeftButtonDown="NodeItem_MouseLeftButtonDown"
                                        MouseMove="NodeItem_MouseMove"
                                        Cursor="Hand">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Bold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
