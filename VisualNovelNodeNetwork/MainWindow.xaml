<Window x:Class="NodeNetworkExample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NodeNetworkExample"
        xmlns:nodenetwork="clr-namespace:NodeNetwork.Views;assembly=NodeNetwork"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- Network View -->
        <nodenetwork:NetworkView x:Name="networkView" Grid.Column="0" 
                                 ViewModel="{Binding Network}"
                                 AllowDrop="True" 
                                 Drop="NetworkView_Drop" 
                                 DragOver="NetworkView_DragOver" />

        <!-- Node List Panel -->
        <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Background="#F5F5F5">
            <DockPanel>
                <!-- Header -->
                <TextBlock DockPanel.Dock="Top" Text="Available Nodes" FontWeight="Bold" Padding="10" FontSize="14" />
                <TextBlock DockPanel.Dock="Top" Text="Drag to canvas" FontSize="11" Foreground="#666666" Padding="10,0,10,10" />

                <!-- Node Type List -->
                <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="nodeListBox" ItemsSource="{Binding NodeList.NodeTypes}" Padding="0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Background="White" Margin="8,4" 
                                        BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                                        MouseLeftButtonDown="NodeItem_MouseLeftButtonDown"
                                        MouseMove="NodeItem_MouseMove"
                                        Cursor="Hand">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
